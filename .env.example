# ---- الخادم ----
PORT=8095
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8095

# خلف Cloudflare Tunnel خلّها 1 عشان تقرأ IP الزائر الحقيقي
TRUST_PROXY=1

# ---- البيانات ----
# مفتاح TMDB (v3) أو توكن v4 (يبدأ بـ eyJ) — مجاني: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_LANG=ar-SA
TMDB_REGION=SA
NETFLIX_PROVIDER_ID=8

# ---- الحماية ----
# مفتاح الفهرسة الإدارية. ولّد واحد: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=
MAX_INFLIGHT=80
PROBE_TIMEOUT_MS=6000
PROBE_TTL_MS=21600000
REQUEST_TIMEOUT_MS=12000

# ---- تخزين ----
DB_PATH=./data/flix.db
SUBS_DIR=./data/subs

# ---- اختياري ----
OPENSUBTITLES_API_KEY=
SUBTITLE_LANG=ar
LOG_REQUESTS=0
NODE_ENV=production

# نطاقات YTS البديلة (الأساسي محجوب في بعض الشبكات)
YTS_HOSTS=yts.gg,yts.lt,yts.am
# حد البروبات الخارجية المتزامنة (حماية من flood)
PROBE_GLOBAL_LIMIT=8
